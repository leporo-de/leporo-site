---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Kontakt – Leporo"
  description="Kontaktieren Sie Leporo persönlich per E-Mail oder Telefon."
>
  <section class="contact-hero">
    <div class="container">
      <p class="eyebrow">Kontakt</p>
      <h1>Erzählen Sie uns von Ihrer Aufgabe.</h1>
      <p class="lead">
        Am einfachsten erreichen Sie uns direkt per E-Mail oder Telefon.
      </p>
    </div>
  </section>
  <section class="section">
    <div class="container contact-grid">
      <article>
        <p class="eyebrow">Per E-Mail</p>
        <h2>Schreiben Sie uns</h2>
        <p>
          Ihr E-Mail-Programm öffnet sich mit einer neuen Nachricht an Leporo.
        </p>
        <a
          class="button"
          href="mailto:info@leporo.de?subject=Anfrage%20über%20leporo.de"
          >E-Mail an info@leporo.de</a
        >
      </article>
      <aside>
        <p class="eyebrow">Direkt erreichbar</p>
        <h2>Leporo GmbH</h2>
        <address>Brahmsweg 2<br />45731 Waltrop</address>
        <div>
          <a href="mailto:info@leporo.de">info@leporo.de</a><br />
          <a href="tel:+491722136271">0172 21 36 271</a>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-hero {
    padding-block: clamp(5rem, 11vw, 8rem);
    background: var(--mint-pale);
  }
  .contact-hero .container,
  article,
  aside {
    display: grid;
    gap: 1.2rem;
  }
  .contact-grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: clamp(2rem, 7vw, 6rem);
  }
  article,
  aside {
    align-content: start;
  }
  article .button {
    justify-self: start;
  }
  aside {
    padding: 2rem;
    border-radius: var(--radius);
    background: var(--sand);
  }
  address {
    color: var(--ink-soft);
    font-style: normal;
  }
  aside a {
    text-underline-offset: 0.2em;
  }
  @media (max-width: 740px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
