---
import { sitePath } from "../lib/sitePath";

export function getStaticPaths() {
  const redirects = {
    inventuren: "leistungen/inventuren/",
    akten: "leistungen/aktensanierung/",
    "leporo-inventarsanierung": "leistungen/inventarsanierung/",
    simkartentausch: "leistungen/sim-kartentausch/",
    bueroreinigung: "leistungen/bueroreinigung/",
    kontaktformular: "kontakt/",
    "kontakt-2": "kontakt/",
  };

  return Object.entries(redirects).map(([legacy, target]) => ({
    params: { legacy },
    props: { target },
  }));
}

const { target } = Astro.props;
const destination = sitePath(target);
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'none'; base-uri 'self'; form-action 'none'; script-src 'none'; style-src 'none'"
    />
    <meta name="referrer" content="no-referrer" />
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content={`0;url=${destination}`} />
    <link rel="canonical" href={new URL(destination, Astro.site)} />
    <title>Weiterleitung – Leporo</title>
  </head>
  <body>
    <p>
      Die Seite wurde verschoben. <a href={destination}>Weiter zu Leporo</a>
    </p>
  </body>
</html>
